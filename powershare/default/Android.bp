cc_binary {
    name: "vendor.lineage.powershare-service.default",
    defaults: ["powershare_defaults"],
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.powershare-service.default.rc"],
    vintf_fragments: ["vendor.lineage.powershare-service.default.xml"],
    srcs: [
        "service.cpp",
        "PowerShare.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.lineage.powershare-V1-ndk",
    ],
}
